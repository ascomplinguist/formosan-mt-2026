# Ignore everything in the repo by default
*

# But allow Git to see directories, so unignore rules can reach files inside them
!*/
.*
bitsandbytes/

# Keep selected files
!/train_nllb.py
!/train_madlad.py
!/train_llama.py
!/eval_nllb.py
!/eval_madlad.py
!/eval_llama.py
!/bleu_eval.py
!/bleu_eval_madlad.py
!/bleu_eval_llama.py
!/lm_head.py
!/check_git_status.py
!/evaluate_file.py
!/convert_lang_code.py
!/generate_tsv.py
!/compute_embedding_distance_matrix.py
!/embedding_vectors.json
!/embedding_distances.json
!/*finetune.tsv
!/README.md
!/.gitignore

# Keep train, val, test sets
!/FormosanBench_new/*.parquet

# Only look at nllb finetunes in work/ (add config.json and trainer_state.json in these dirs)
!/tracked_work/work/*nllb*/**
!/tracked_work/joseph/*nllb*/**
!/tracked_work/deborah/*nllb*/**
!/tracked_work/work/*madlad*/**
!/tracked_work/joseph/*madlad*/**
!/tracked_work/deborah/*madlad*/**
!/tracked_work/work/*llama*/**
!/tracked_work/joseph/*llama*/**
!/tracked_work/deborah/*llama*/**

# Ignore intermediate checkpoints, only add eval data inside final checkpoint
**/checkpoint-*/
**/final/*
!**/final/eval*
!**/final/test*

# Just to be safe, never add safetensors, optimiser states or rng states
*.safetensors
*.pt
*.pth

# Save special initialisation vectors
!/tracked_work/work/vectors/*.pt
